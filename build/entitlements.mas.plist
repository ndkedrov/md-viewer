<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store: the app runs in the App Sandbox -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Electron needs a team-prefixed app group for its helper processes -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>4LZ5572PRZ.com.ndkedrov.mdviewer</string>
  </array>
  <key>com.apple.application-identifier</key>
  <string>4LZ5572PRZ.com.ndkedrov.mdviewer</string>
  <key>com.apple.developer.team-identifier</key>
  <string>4LZ5572PRZ</string>
  <!-- Read the documents and folders the user opens, and remember them between launches -->
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- Show images that documents load from the web -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.print</key>
  <true/>
</dict>
</plist>
