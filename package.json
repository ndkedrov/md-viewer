{
  "name": "md-viewer",
  "productName": "MD Viewer",
  "version": "1.1.0",
  "description": "A beautiful tabbed Markdown viewer for Windows and macOS",
  "main": "src/main/main.js",
  "author": "ndkedrov",
  "license": "MIT",
  "homepage": "https://github.com/ndkedrov/md-viewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndkedrov/md-viewer.git"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:dir": "electron-builder --win dir",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:mas": "electron-builder --mac mas --universal --publish never",
    "dist:mas-dev": "electron-builder --mac mas-dev --arm64 --publish never"
  },
  "build": {
    "appId": "com.ndkedrov.mdviewer",
    "productName": "MD Viewer",
    "copyright": "Copyright © 2026 ndkedrov",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MD-Viewer-Setup-${version}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "name": "MDViewer.Markdown",
          "description": "Markdown document",
          "icon": "build/file.ico",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MD Viewer",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE"
    },
    "mac": {
      "appId": "mdviewer.serenity.games",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "13.0",
      "bundleVersion": "1",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "notarize": true,
      "artifactName": "MD-Viewer-${version}-mac.${ext}",
      "extraResources": [
        {
          "from": "build/file.icns",
          "to": "file.icns"
        }
      ],
      "extendInfo": {
        "ElectronTeamID": "4LZ5572PRZ",
        "ITSAppUsesNonExemptEncryption": false,
        "NSHumanReadableCopyright": "Copyright © 2026 ndkedrov",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Default",
            "CFBundleTypeIconFile": "file.icns",
            "LSItemContentTypes": [
              "net.daringfireball.markdown"
            ],
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "mdown",
              "mkd"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown document",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeIconFile": "file.icns",
            "UTTypeReferenceURL": "https://daringfireball.net/projects/markdown/",
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown",
                "mdown",
                "mkd"
              ],
              "public.mime-type": [
                "text/markdown"
              ]
            }
          }
        ]
      }
    },
    "dmg": {
      "title": "MD Viewer ${version}"
    },
    "mas": {
      "appId": "mdviewer.serenity.games",
      "type": "distribution",
      "hardenedRuntime": false,
      "notarize": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/MD_Viewer_Mac_App_Store.provisionprofile",
      "artifactName": "MD-Viewer-${version}-mas.${ext}"
    },
    "masDev": {
      "appId": "mdviewer.serenity.games",
      "type": "development",
      "hardenedRuntime": false,
      "notarize": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/MD_Viewer_Mac_Development.provisionprofile"
    },
    "electronLanguages": [
      "en",
      "en-US",
      "uk"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "mermaid": "^12.2.0"
  }
}
